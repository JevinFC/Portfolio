---
import "./page.scss";

const { crumb, parents = [], title, lead, actions = [] } = Astro.props;
---

<div class="pageHeroWrap">
  <section class="pageHero" aria-labelledby="pageTitle">
    <div class="pageHeroInner">
      <nav class="pageCrumbs" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a>
        <span aria-hidden="true">›</span>
        {
          parents.map((parent) => (
            <>
              <a href={parent.href}>{parent.label}</a>
              <span aria-hidden="true">›</span>
            </>
          ))
        }
        <span aria-current="page">{crumb}</span>
      </nav>
      <h1 class="pageTitle" id="pageTitle">{title}</h1>
      {lead && <p class="pageLead">{lead}</p>}
      {
        actions.length > 0 && (
          <div class="pageActions">
            {actions.map((action, index) => (
              <a
                class={index === 0 ? "pageCta" : "pageLink"}
                href={action.href}
                target={action.external ? "_blank" : undefined}
                rel={action.external ? "noopener noreferrer" : undefined}
              >
                {action.label}
                {(index > 0 || action.external) && <span aria-hidden="true">{action.external ? "↗" : "→"}</span>}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
  <img class="pageHeroAxe" src="/logo-hachado-h.webp" alt="" width="303" height="380" aria-hidden="true" />
</div>
